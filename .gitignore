.env
.env.*
/backend/config/config.env
/backend/config/*.env
/frontend/.env
/frontend/.env.*
!.env.example
!/backend/config/*.env.example
!/frontend/.env.example

# misc
.DS_Store
/frontend/.DS_Store

npm-debug.log*
yarn-debug.log*
yarn-error.log*
