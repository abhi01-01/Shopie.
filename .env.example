# Shopie environment template
#
# The backend currently loads backend/config/config.env when NODE_ENV is not
# PRODUCTION. Keep this root file as a reviewer-friendly reference and copy
# the same values into backend/config/config.env for local development.

PORT=4000
NODE_ENV=DEVELOPMENT

DB_URI=mongodb://127.0.0.1:27017/shopie
FRONTEND_URL=http://localhost:3000

JWT_SECRET=
JWT_EXPIRE=5d
COOKIE_EXPIRE=5

CLOUDINARY_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=

# Preferred SMTP names. The backend still accepts legacy SMPT_* names.
SMTP_SERVICE=gmail
SMTP_MAIL=your-email@example.com
SMTP_PASSWORD=

# Legacy aliases retained for older Render environments.
SMPT_SERVICE=
SMPT_MAIL=
SMPT_PASSWORD=

STRIPE_API_KEY=
STRIPE_SECRET_KEY=

# Optional for Create React App local proxy.
API_PROXY_TARGET=http://localhost:4000
